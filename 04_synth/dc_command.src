#!/bin/bash

#============== SET DIRECTORY =================
set search_path ". /home/albert/Desktop/KoggeStone_8bit_adder/04_synth/lib"
set osearch_path [ concat $search_path ]

#============== ADD THE LIBRARY ================
set target_library "NangateOpenCellLibrary_typical.db"
set link_library "* $target_library"
set synthesis_library standard.sldb

#============= ANALYSE DESIGN ==================
analyze -format sverilog "./../../02_rtl/KoggeStone_8bit.sv"
elaborate KoggeStoneAdder8bit
current_design KoggeStoneAdder8bit

#============= CONSTRAINT FOR DESIGN ============
# Ép xung nhịp cực độ: 0.1 ns (10 GHz) để ép tool giữ kiến trúc song song
create_clock -name clk -period 0.4 {clk}

# Bóp nghẹt I/O delay để dồn toàn bộ quỹ thời gian cho bộ cộng
set_input_delay -max 0.01 -clock clk  [all_inputs] 
set_input_delay -min 0.00 -clock clk  [all_inputs] 
set_output_delay -max 0.01 -clock clk [all_outputs] 
set_output_delay -min 0.00 -clock clk [all_outputs] 
set_fanout_load 8 [all_outputs]  

#============= SYNTHESIZE========================
compile_ultra

#============= REPORT PERFORMANCE ===============
report_area > ./../report/report.area

# Bắt tool báo cáo top 10 đường trễ nhất (tránh bị tụt mất path của mạch cộng)
report_timing -nworst 10 -max_paths 10 > ./../report/report.timing

report_constraint > ./../report/report.constraint
report_qor > ./../report/report.qor

write -f ddc -o ./../report/report.ddc
write -format verilog -hierarchy -output ./../report/lab_synth.netlist.v
write_sdf ./../report/report.sdf
write_sdc ./../report/report.sdc

quit