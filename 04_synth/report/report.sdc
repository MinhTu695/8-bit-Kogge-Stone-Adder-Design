set_input_delay -clock clk  -min 0  [get_ports {B[1]}]
set_input_delay -clock clk  -max 0.01  [get_ports {B[0]}]
set_input_delay -clock clk  -min 0  [get_ports {B[0]}]
set_output_delay -clock clk  -max 0.01  [get_ports {S[7]}]
set_output_delay -clock clk  -min 0  [get_ports {S[7]}]
set_output_delay -clock clk  -max 0.01  [get_ports {S[6]}]
set_output_delay -clock clk  -min 0  [get_ports {S[6]}]
