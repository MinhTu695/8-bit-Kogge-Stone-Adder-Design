#!/bin/bash

#================================================
# SET DIRECTORY
#================================================
set search_path "/home/hoangtrang/KoggeStone_8bit_adder/04_synth/lib"

#================================================
# ADD LIBRARY
#================================================
set target_library "NangateOpenCellLibrary_typical.db"
set link_library "* $target_library"

#================================================
# READ NETLIST
#================================================
read_verilog "./../04_synth/report/lab_synth.netlist.v"

current_design KoggeStoneAdder8bit

link

#================================================
# UNITS
#================================================
set_units -time ns \
          -resistance MOhm \
          -capacitance fF \
          -voltage V \
          -current mA

set_max_area 0

#================================================
# CLOCK DEFINITION
#================================================
create_clock -name clk -period 0.5 [get_ports clk]

# clock uncertainty
set_clock_uncertainty 0.02 [get_clocks clk]

# estimated clock latency
set_clock_latency 0.05 [get_clocks clk]

# clock transition
set_clock_transition 0.02 [get_clocks clk]

#================================================
# INPUT / OUTPUT CONSTRAINTS
#================================================

# input drive strength
set_driving_cell -lib_cell BUF_X1 [all_inputs]

# exclude clock from input delay
set data_inputs [remove_from_collection [all_inputs] [get_ports clk]]

# input delay
set_input_delay  -max 0.02 -clock clk $data_inputs
set_input_delay  -min 0.01 -clock clk $data_inputs

# output delay
set_output_delay -max 0.02 -clock clk [all_outputs]
set_output_delay -min 0.01 -clock clk [all_outputs]

# output load
set_load 0.01 [all_outputs]

#================================================
# OPERATING CONDITIONS
#================================================
set_operating_conditions -analysis_type on_chip_variation

#================================================
# CREATE REPORT DIRECTORIES
#================================================
file mkdir report
file mkdir report/report_design
file mkdir report/report_sta

#================================================
# DESIGN REPORTS
#================================================
report_design        > report/report_design/report.design
report_net           > report/report_design/report.net
report_cell          > report/report_design/report.cell
report_hierarchy     > report/report_design/report.hierarchy
report_clock         > report/report_design/report.clock
report_path_group    > report/report_design/report.pg

#================================================
# STA REPORTS
#================================================
report_timing -delay_type max  \
    > report/report_sta/report_timing_max.rpt

report_timing -delay_type min  \
    > report/report_sta/report_timing_min.rpt

report_constraint -all_violators \
    > report/report_sta/report_constraint.rpt

report_global_slack \
    > report/report_sta/report_global_slack.rpt

report_analysis_coverage \
    > report/report_sta/report_analysis_coverage.rpt

report_qor \
    > report/report_sta/report_qor.rpt

report_port \
    > report/report_sta/report_port.rpt

quit